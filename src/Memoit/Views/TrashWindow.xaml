<Window x:Class="Memoit.Views.TrashWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OmniMemo · 휴지통" Width="640" Height="660" MinWidth="480" MinHeight="400"
 ShowInTaskbar="False" WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic"
 FontSize="13" Background="#F7F8FA" Foreground="#29313D">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,6"/>
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9DFE7"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#29313D"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF0F7"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCE6F2"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#3265AA"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24" Background="#F7F8FA">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="휴지통" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="삭제한 메모를 복원하거나 영구 삭제할 수 있습니다." Foreground="#687384" Margin="0,6,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,16">
   <TextBox x:Name="search" Padding="10,9" BorderBrush="#D9DFE7" BorderThickness="1" ToolTip="휴지통 검색" AutomationProperties.Name="휴지통 검색"/>
   <TextBlock Text="삭제한 메모 검색" Margin="11,0" VerticalAlignment="Center" Foreground="#778191" IsHitTestVisible="False">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </Grid>
  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="status" VerticalAlignment="Center" Foreground="#687384"/>
   <Button x:Name="deleteSelected" Grid.Column="1" Content="선택 영구 삭제" IsEnabled="False"/>
  </Grid>
  <Grid Grid.Row="3">
   <ListBox x:Name="list" SelectionMode="Extended" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="휴지통 목록">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Card" Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="8" Padding="14"><ContentPresenter/></Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EDF4FE"/><Setter TargetName="Card" Property="BorderBrush" Value="#638FC7"/></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#3265AA"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="{Binding Color}" CornerRadius="2"/>
       <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" ToolTip="{Binding Title}"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding DeletedAt, StringFormat={}{0:yyyy.MM.dd HH:mm} 삭제}" FontSize="11" Foreground="#778191" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="복원" MinWidth="68" Margin="0,0,8,0" Click="OnRestore" ToolTip="전체 메모로 복원"/>
        <Button Content="영구 삭제" MinWidth="82" Click="OnDelete" Foreground="#A33B3B" ToolTip="이 메모를 영구 삭제"/>
       </StackPanel>
      </Grid>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock x:Name="empty" Text="휴지통이 비어 있습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#778191"/>
  </Grid>
  <Grid Grid.Row="4" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Ctrl / Shift로 여러 메모 선택" FontSize="11" Foreground="#778191" VerticalAlignment="Center"/>
   <Button x:Name="emptyTrash" Grid.Column="1" Content="휴지통 비우기" Foreground="#A33B3B" IsEnabled="False" ToolTip="검색 결과와 관계없이 휴지통의 모든 메모를 영구 삭제"/>
  </Grid>
 </Grid>
</Window>
