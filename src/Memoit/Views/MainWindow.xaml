<Window Icon="/OmniMemo;component/Assets/OmniMemo.ico" ShowInTaskbar="False" x:Class="Memoit.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OmniMemo · 메모 목록" Width="580" Height="680" MinWidth="430" MinHeight="420" Background="#F7F7F3" FontFamily="Malgun Gothic" Foreground="#292D35" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDDFD7"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button DockPanel.Dock="Right" Content="설정" Click="OnSettings" Margin="0"/><StackPanel><TextBlock Text="OmniMemo" FontSize="27" FontWeight="Bold"/><TextBlock Text="작은 생각을 놓치지 않도록" Foreground="#74776D" Margin="0,4,0,0"/></StackPanel></DockPanel>
  <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,22,0,14" Padding="12,10" FontSize="14" Background="White" BorderBrush="#DDDFD7" TextChanged="OnSearchTextChanged" ToolTip="메모 내용 검색 (Ctrl+F)" AutomationProperties.Name="메모 내용 검색"/>
  <DockPanel Grid.Row="2" Margin="0,0,0,15"><Button DockPanel.Dock="Right" Content="＋ 새 메모" Click="OnNew" Background="#E9EEDE" Margin="0"/><StackPanel Orientation="Horizontal"><Button x:Name="ActiveButton" Content="전체 메모" Click="OnActive" FontWeight="Bold"/><Button x:Name="TrashButton" Content="휴지통" Click="OnTrash"/></StackPanel></DockPanel>
  <TextBlock x:Name="SectionLabel" Grid.Row="3" Foreground="#70766A" FontSize="12" Margin="0,0,0,10"/>
  <Grid Grid.Row="4">
   <ListBox x:Name="NoteList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnOpen" KeyDown="OnListKeyDown" AutomationProperties.Name="메모 목록">
    <ListBox.ItemTemplate><DataTemplate>
     <Border Background="{Binding Color}" Padding="16" CornerRadius="5"><StackPanel>
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Preview}" Foreground="#56594F" Margin="0,7,0,10" TextWrapping="Wrap" MaxHeight="42"/>
      <DockPanel><TextBlock Text="{Binding Modified}" FontSize="11" Foreground="#6B7062" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="열기" Tag="{Binding Id}" Click="OnOpenButton" Visibility="{Binding ActiveVisibility}" Padding="10,4" Margin="0"/><Button Content="복원" Tag="{Binding Id}" Click="OnRestore" Visibility="{Binding TrashVisibility}" Padding="10,4"/><Button Content="영구 삭제" Tag="{Binding Id}" Click="OnPermanentDelete" Visibility="{Binding TrashVisibility}" Foreground="#9A3D3D" Padding="10,4" Margin="0"/></StackPanel></DockPanel>
     </StackPanel></Border>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock x:Name="EmptyLabel" Text="메모가 없습니다. 새 메모로 시작하세요." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#74776D" IsHitTestVisible="False"/>
  </Grid>
  <TextBlock Grid.Row="5" Text="창을 닫아도 트레이에서 계속 실행됩니다." Foreground="#858A7D" FontSize="11" Margin="0,14,0,0"/>
 </Grid>
</Window>


