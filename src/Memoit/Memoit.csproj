<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/OmniMemo.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyName>OmniMemo</AssemblyName>
    <Product>OmniMemo</Product>
    <Title>OmniMemo</Title>
    <Description>OmniMemo · 로컬 스티커 메모</Description>
    <!-- This is a WPF app; NotifyIcon alone must not replace the WPF DPI manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/OmniMemo.ico" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
